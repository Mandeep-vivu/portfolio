# Copy to .env.local and fill in. Everything is optional for local development:
# without any AI key the chat still answers from portfolio data.

# --- AI providers (server-only) ---------------------------------------------
# Primary chat model. OPENAI_API_KEY takes priority over GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback when the primary model is out of quota.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Public site configuration ----------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/mandeepsingh7official/30min

# --- Admin (/admin) ---------------------------------------------------------
# AUTH_SECRET must be at least 32 characters: openssl rand -base64 32
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Persistent content storage for admin edits (Upstash Redis REST).
# Required in production; development falls back to memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob token for PDF resume uploads.
BLOB_READ_WRITE_TOKEN=

# --- Scripts ----------------------------------------------------------------
# npm run sync-github
GITHUB_USERNAME=Mandeep-vivu
# Optional, avoids GitHub rate limiting.
GITHUB_TOKEN=
# Optional, enriches project metadata; rule-based fallback otherwise.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
